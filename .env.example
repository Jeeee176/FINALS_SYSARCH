APP_NAME="Bus Tracking and Fleet Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bus_tracking
DB_USERNAME=root
DB_PASSWORD=

# ── Test database (used by verification scripts in tests/verification/) ──
# To run verification scripts against a separate test database:
#   1. Create the database in MySQL: CREATE DATABASE bus_tracking_test;
#   2. Uncomment and set the lines below:
#   3. Run: php tests/verification/verify_rbac.php
#
# DB_CONNECTION_TEST=mysql
# DB_HOST_TEST=127.0.0.1
# DB_PORT_TEST=3306
# DB_DATABASE_TEST=bus_tracking_test
# DB_USERNAME_TEST=root
# DB_PASSWORD_TEST=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/